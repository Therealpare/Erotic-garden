# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
# Comma-separated list of allowed browser origins.
FRONTEND_ORIGIN=http://localhost:4200
# Set to true when running behind a hosting proxy (Render, Railway, Fly…) so rate limits see real client IPs.
TRUST_PROXY=false

# --- Database (PostgreSQL) ---
# Either one connection string (Neon / Supabase / Render / Railway)…
# DATABASE_URL=
# …or individual settings:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=erotic_garden
# Most hosted PostgreSQL providers require SSL.
DB_SSL=false
# Run pending migrations automatically on startup (handy on hosts without a release step).
DB_MIGRATIONS_RUN=false

# --- Authentication (admin CMS) ---
# Long random strings, different from each other, e.g. `openssl rand -base64 48`.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- LINE Official Account alerts (Messaging API) ---
# Backend-only secrets: never put these in the Angular app or commit them.
# Long-lived channel access token: LINE Developers console → your OA's Messaging API channel
#   → "Messaging API" tab → Channel access token (long-lived) → Issue.
LINE_CHANNEL_ACCESS_TOKEN=
# Who receives alerts: your LINE user ID (starts with "U", 33 characters) from the channel's
# "Basic settings" tab → "Your user ID". A group ID ("C…") also works. May be left empty for now.
LINE_ADMIN_USER_ID=
# Public site URL, used to add an /admin/events link to alert messages (optional).
ADMIN_BASE_URL=

# --- Image storage (spec §7) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
