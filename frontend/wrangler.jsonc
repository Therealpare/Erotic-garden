// Cloudflare Worker for the site (Workers & Pages → "eroticgarden").
// Build settings in the dashboard: root directory `frontend`, build command
// `npm run build`, deploy command `npx wrangler deploy`.
// Secrets (Settings → Variables and Secrets): LINE_CHANNEL_ACCESS_TOKEN, LINE_ADMIN_USER_ID.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eroticgarden",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/frontend/browser",
    "binding": "ASSETS",
    // Pages are prerendered to e.g. coffee/index.html and served at /coffee (no trailing slash).
    // Anything else falls through to the Worker, which serves the app shell (index.csr.html).
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    // Every request goes through the Worker first: it redirects www/http/workers.dev to the
    // main address and handles /api/booking; everything else is served from the assets.
    "run_worker_first": true
  },
  // At most 5 booking requests per minute from one IP address.
  "ratelimits": [
    {
      "name": "BOOKING_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": { "SITE_HOST": "eroticgardenchiangmai.com" },
  // Keep variables added in the dashboard when deploying (LINE_* must still be type "Secret").
  "keep_vars": true,
  "observability": { "enabled": true }
}
